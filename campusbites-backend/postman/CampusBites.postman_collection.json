    {
      "name": "Orders",
      "item": [
        {
          "name": "1. Place Group Order (Create - ₹45 Delivery)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Rohan Mehta\",\n  \"phone\": \"9876543210\",\n  \"hostel\": \"Hostel 4, Room 302\",\n  \"paymentMode\": \"upi\",\n  \"notes\": \"Ring room bell on delivery\",\n  \"mode\": \"group\",\n  \"groupCode\": \"CB-7X2W\",\n  \"items\": [\n    {\n      \"member\": \"Rohan\",\n      \"item\": \"Classic Burger\",\n      \"quantity\": 1,\n      \"price\": 149\n    },\n    {\n      \"member\": \"Aman\",\n      \"item\": \"Crispy Fries\",\n      \"quantity\": 2,\n      \"price\": 99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
